{
  "name": "@galactica-net/overcast-private-stablecoin",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Aztec Noir token contract for private, compliance-aware transfers (forked from Aztec private_token_contract).",
  "scripts": {
    "clean": "rm -rf ./src/artifacts ./target ./codegenCache.json",
    "clear-store": "rm -rf ./store",
    "codegen": "aztec codegen ../../target --outdir src/artifacts",
    "compile": "cd ../.. && aztec compile --workspace",
    "deploy": "NODE_NO_WARNINGS=1 yarn exec tsx scripts/deploy_contract.ts",
    "deploy::testnet": "NODE_NO_WARNINGS=1 AZTEC_ENV=testnet yarn exec tsx scripts/deploy_contract.ts",
    "deploy:bridge": "NODE_NO_WARNINGS=1 yarn exec tsx scripts/deploy_token_bridge.ts",
    "fee-juice:setup": "NODE_NO_WARNINGS=1 yarn exec tsx scripts/setup_fee_juice.ts",
    "fee-juice:setup::testnet": "NODE_NO_WARNINGS=1 AZTEC_ENV=testnet yarn exec tsx scripts/setup_fee_juice.ts",
    "fee-juice:setup::mainnet": "NODE_NO_WARNINGS=1 AZTEC_ENV=mainnet yarn exec tsx scripts/setup_fee_juice.ts",
    "test": "yarn test:js && yarn test:nr",
    "test::testnet": "AZTEC_ENV=testnet yarn test:js",
    "test:js": "rm -rf store/pxe && NODE_NO_WARNINGS=1 NODE_OPTIONS='--experimental-vm-modules' yarn exec jest --no-cache --runInBand --config jest.integration.config.json",
    "test:js:e2e": "RUN_AZTEC_E2E=1 yarn test:js",
    "test:nr": "cd ../.. && aztec test"
  },
  "dependencies": {
    "@aztec-foundation/l1-artifacts": "6.0.0-rc.1",
    "@aztec-labs/accounts": "6.0.0-rc.1",
    "@aztec-labs/aztec.js": "6.0.0-rc.1",
    "@aztec-labs/constants": "6.0.0-rc.1",
    "@aztec-labs/entrypoints": "6.0.0-rc.1",
    "@aztec-labs/ethereum": "6.0.0-rc.1",
    "@aztec-labs/foundation": "6.0.0-rc.1",
    "@aztec-labs/noir-contracts.js": "6.0.0-rc.1",
    "@aztec-labs/protocol-contracts": "6.0.0-rc.1",
    "@aztec-labs/pxe": "6.0.0-rc.1",
    "@aztec-labs/stdlib": "6.0.0-rc.1",
    "@aztec-labs/wallet-sdk": "6.0.0-rc.1",
    "@aztec-labs/wallets": "6.0.0-rc.1",
    "@aztec/aztec.js": "npm:@aztec-labs/aztec.js@6.0.0-rc.1",
    "@aztec/constants": "npm:@aztec-labs/constants@6.0.0-rc.1",
    "@aztec/protocol-contracts": "npm:@aztec-labs/protocol-contracts@6.0.0-rc.1",
    "@aztec/stdlib": "npm:@aztec-labs/stdlib@6.0.0-rc.1",
    "@wonderland/aztec-fee-payment": "4.2.0",
    "dotenv": "^17.2.2",
    "viem": "npm:@aztec/viem@2.38.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^22.15.1",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.4.4"
  },
  "jest": {
    "testTimeout": 200000
  },
  "config": {
    "aztecVersion": "6.0.0-rc.1"
  },
  "engines": {
    "node": ">=24"
  }
}
